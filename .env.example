# Copy to .env at the repository root. The backend reads that file.
# Do not commit .env. Do not put the key in frontend code.

# Free key: https://collegefootballdata.com/key
# Leave blank to keep live retrieval unavailable.
CFBD_API_KEY=

# live = call CollegeFootballData.com on a cache miss.
# fixture = serve backend/fixtures, which are synthetic and labeled.
CFIP_DATA_MODE=live

CFBD_BASE_URL=https://api.collegefootballdata.com
CFBD_TIMEOUT_SECONDS=20
CFBD_MAX_RETRIES=3
CFBD_BACKOFF_SECONDS=0.5
CFBD_CACHE_TTL_SECONDS=86400

# SQLite path is resolved from the backend directory.
# A postgres:// or postgresql:// URL is accepted by SQLAlchemy and is not covered by the tests.
DATABASE_URL=sqlite:///./data/cfip.db

CFIP_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
CFIP_LOG_LEVEL=INFO
CFIP_AUTO_MIGRATE=true

# Optional. The UI calls /cfip-api on the Next.js origin, and Next proxies to the API.
# Set NEXT_PUBLIC_API_BASE_URL only when the browser should call the API host directly.
# CFIP_API_PROXY_TARGET=http://127.0.0.1:43124
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:43124
